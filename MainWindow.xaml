<Window x:Class="PacDancegameDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pac Dancegame Demo" Height="720" Width="1200" Background="#FF101010"
        Focusable="True"
        WindowStyle="None"
        WindowState="Maximized"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewKeyUp="OnPreviewKeyUp"
        MouseDown="OnMouseDown">
  <Grid Margin="24">
    <Grid>
      <Border CornerRadius="16" Background="#FF050505" BorderBrush="#FF2A2A2A" BorderThickness="1">
        <Grid>
          <MediaElement x:Name="BackgroundVideo"
                        LoadedBehavior="Manual"
                        UnloadedBehavior="Manual"
                        Stretch="UniformToFill"
                        IsMuted="True"
                        Visibility="Collapsed" />
          <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.6" />
          <Grid Margin="24">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Top" Margin="0,40,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Now Playing" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text=" • " Foreground="#FFB0B0B0" Margin="8,0" />
                <TextBlock x:Name="NowPlaying" Foreground="#FFB0B0B0" FontSize="18" />
              </StackPanel>
              <Border x:Name="SongCarouselPanel" Background="#33000000" CornerRadius="20" Padding="24" Margin="0,40,0,0" HorizontalAlignment="Right">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="520" />
                  </Grid.ColumnDefinitions>
                  <StackPanel HorizontalAlignment="Center">
                    <Image x:Name="SongPreviewImage" Width="220" Height="220" Stretch="UniformToFill" Margin="0,0,0,12" />
                    <TextBlock x:Name="SongPreviewTitle" FontSize="22" Foreground="White" HorizontalAlignment="Center" />
                    <ListBox x:Name="DifficultyList"
                             Height="120"
                             Margin="0,12,0,0"
                             Background="Transparent"
                             BorderBrush="Transparent"
                             HorizontalContentAlignment="Center"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden">
                      <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                          <Setter Property="FontSize" Value="16" />
                          <Setter Property="Foreground" Value="#FFB0B0B0" />
                          <Setter Property="Opacity" Value="0.5" />
                          <Setter Property="Padding" Value="8,4" />
                          <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter Property="FontSize" Value="20" />
                              <Setter Property="Opacity" Value="1" />
                              <Setter Property="Foreground" Value="#FF3DDCFF" />
                            </Trigger>
                          </Style.Triggers>
                        </Style>
                      </ListBox.Resources>
                    </ListBox>
                    <TextBlock x:Name="PressStartText" Text="Press Start (1)" Foreground="#FFB0B0B0" Margin="0,10,0,0" FontSize="16" HorizontalAlignment="Center" />
                  </StackPanel>
                  <ListBox x:Name="SongList"
                           Grid.Column="1"
                           Background="#88222222"
                           BorderBrush="#FF5A5A5A"
                           Foreground="White"
                           Height="480"
                           Margin="40,0,0,0"
                           HorizontalContentAlignment="Right"
                           VerticalContentAlignment="Center"
                           ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <ListBox.Resources>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Right" />
                        <Setter Property="Padding" Value="18,8" />
                        <Setter Property="FontSize" Value="18" />
                        <Setter Property="Opacity" Value="0.25" />
                        <Setter Property="Foreground" Value="#FFB0B0B0" />
                        <Setter Property="RenderTransformOrigin" Value="1,0.5" />
                        <Setter Property="RenderTransform">
                          <Setter.Value>
                            <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                          </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontSize" Value="28" />
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="#FF3DDCFF" />
                            <Setter Property="RenderTransform">
                              <Setter.Value>
                                <ScaleTransform ScaleX="1.35" ScaleY="1.35" />
                              </Setter.Value>
                            </Setter>
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </ListBox.Resources>
                  </ListBox>
                </Grid>
              </Border>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="BPM" Margin="0,0,12,0" Foreground="#FFB0B0B0" VerticalAlignment="Center" />
                <TextBlock x:Name="BpmValue" Foreground="White" FontSize="16" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1" x:Name="LaneGrid">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" BorderBrush="#33FFFFFF" BorderThickness="0,0,1,0" />
              <Border Grid.Column="1" BorderBrush="#33FFFFFF" BorderThickness="0,0,1,0" />
              <Border Grid.Column="2" BorderBrush="#33FFFFFF" BorderThickness="0,0,1,0" />
              <Border Grid.Column="3" BorderBrush="#33FFFFFF" BorderThickness="0,0,0,0" />
              <Border Background="#33FFFFFF" Height="4" VerticalAlignment="Center" Panel.ZIndex="1" />
              <TextBlock x:Name="HitResultText"
                         FontSize="42"
                         FontWeight="SemiBold"
                         Foreground="White"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Panel.ZIndex="2" />
              <Canvas x:Name="ArrowCanvas"
                      ClipToBounds="True"
                      Panel.ZIndex="3"
                      Width="{Binding ActualWidth, ElementName=LaneGrid}"
                      Height="{Binding ActualHeight, ElementName=LaneGrid}" />
            </Grid>
          </Grid>
        </Grid>
      </Border>

      <TextBlock x:Name="GetReadyText"
                 Text="GET READY"
                 FontSize="52"
                 FontWeight="SemiBold"
                 Foreground="White"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Visibility="Collapsed"
                 Panel.ZIndex="6" />
      <TextBlock x:Name="CountdownText"
                 FontSize="72"
                 FontWeight="Bold"
                 Foreground="White"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Visibility="Collapsed"
                 Panel.ZIndex="6" />
      <Border Background="#AA000000"
              Visibility="Collapsed"
              x:Name="FailureOverlay"
              CornerRadius="16"
              Panel.ZIndex="5" />
      <TextBlock x:Name="FailedText"
                 Text="FAILED"
                 FontSize="64"
                 FontWeight="Bold"
                 Foreground="#FFCCCCCC"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Visibility="Collapsed"
                 Panel.ZIndex="8" />
      <StackPanel x:Name="ScorePanel"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Margin="0,12,0,0"
                  Panel.ZIndex="6">
        <TextBlock x:Name="ScoreText" Text="Score: 0" Foreground="White" FontSize="24" HorizontalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
          <TextBlock x:Name="PerfectText" Text="Perfect: 0" Foreground="#FF3DDCFF" FontSize="20" Margin="0,0,16,0" />
          <TextBlock x:Name="PerfectMultiplierText" Text="x1" Foreground="#FF7EEBFF" FontSize="18" Margin="0,0,16,0" VerticalAlignment="Center" />
          <TextBlock x:Name="GoodText" Text="Good: 0" Foreground="#FFB0FFB0" FontSize="20" Margin="0,0,16,0" />
          <TextBlock x:Name="PoorText" Text="Poor: 0" Foreground="#FFFFB0B0" FontSize="20" />
        </StackPanel>
      </StackPanel>
      <StackPanel x:Name="FinalScorePanel"
                  Visibility="Collapsed"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Panel.ZIndex="7"
                  Background="#88000000"
                  Padding="24">
        <TextBlock x:Name="FinalScoreTitle"
                   Text="FINAL RESULTS"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="White"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="FinalScoreText"
                   Text="Score: 0"
                   FontSize="20"
                   Foreground="White"
                   Margin="0,10,0,0"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="FinalGradeText"
                   Text="Grade: A"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#FF3DDCFF"
                   Margin="0,6,0,0"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="FinalAccuracyText"
                   Text="Accuracy: 0%"
                   FontSize="18"
                   Foreground="#FFB0B0B0"
                   Margin="0,4,0,0"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="FinalArrowsText"
                   Text="Arrows: 0"
                   FontSize="16"
                   Foreground="#FFB0B0B0"
                   Margin="0,2,0,0"
                   HorizontalAlignment="Center" />
      </StackPanel>

    </Grid>
  </Grid>
</Window>
